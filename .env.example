# ==============================================================================
# CYVORA AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client SDK (Public Web Configuration)
# Obtain these values from: Firebase Console > Project Settings > General > Your apps (Web app)
# Note: These values identify your Firebase web client and are safe for client-side bundle.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. Server & AI Backend Variables (Private / Secret - NOT for client bundle)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls on server-side.
# Configured via the Settings panel in AI Studio or server environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional default model override (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

# APP_URL: Base URL where this applet is hosted.
APP_URL="MY_APP_URL"
